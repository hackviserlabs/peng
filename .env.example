# Replace these values before starting the server.
ADMIN_USERNAME=admin
# Generate a unique value, for example with openssl rand -hex 24.
ADMIN_PASSWORD=

# Use false for local HTTP and true when serving clients over HTTPS.
COOKIE_SECURE=false

# Set to 0 for an automatically assigned loopback port.
PENG_PORT=0

# Set a unique name if the worktree directory name is shared by another checkout.
# COMPOSE_PROJECT_NAME=peng-example
